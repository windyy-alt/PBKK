<Window x:Class="CampusRegistry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campus Registry | Student Dashboard"
        Width="1180" Height="760" MinWidth="1010" MinHeight="670"
        WindowStartupLocation="CenterScreen"
        Background="#FEE6C2" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#684678"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#50375A"/>
            <Setter Property="Background" Value="#FFFBF5"/>
            <Setter Property="BorderBrush" Value="#D9BFE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7F518F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7F518F"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- JUDUL -->
        <Border Grid.Row="0" Background="#7F518F" CornerRadius="17"
                Padding="23,17" Margin="0,0,0,17">
            <Grid>
                <StackPanel>
                    <TextBlock Text="CAMPUS REGISTRY" FontSize="25"
                               FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Student Management Dashboard"
                               FontSize="13" Foreground="#FEE6C2" Margin="0,4,0,0"/>
                </StackPanel>
              
            </Grid>
        </Border>

        <!-- KARTU STATISTIK -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,17">
            <Border Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="JUMLAH MAHASISWA" FontSize="11" Foreground="#8A6798" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtJumlah" Text="0" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="RATA-RATA IPK" FontSize="11" Foreground="#8A6798" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtRata" Text="-" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="IPK TERTINGGI" FontSize="11" Foreground="#8A6798" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTertinggi" Text="-" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="IPK TERENDAH" FontSize="11" Foreground="#8A6798" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTerendah" Text="-" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- FORM KIRI + DATA KANAN -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="332"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="15"
                    Padding="22" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="txtFormTitle" Text="Tambah Mahasiswa"
                                   FontSize="19" FontWeight="Bold" Foreground="#7F518F"/>
                        <TextBlock Text="Isi data mahasiswa di bawah ini."
                                   FontSize="12" Foreground="#9B86A3" Margin="0,4,0,23"/>

                        <TextBlock Text="NRP (10 digit)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtNrp" MaxLength="10" Style="{StaticResource FormInput}"/>

                        <TextBlock Text="Nama Lengkap" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtNama" Style="{StaticResource FormInput}"/>

                        <TextBlock Text="Program Studi" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtProdi" Style="{StaticResource FormInput}"/>

                        <TextBlock Text="IPK (0 - 4)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtIpk" Style="{StaticResource FormInput}"/>

                        <TextBlock x:Name="txtError" Foreground="#C34348"
                                   TextWrapping="Wrap" FontSize="12"
                                   Margin="0,0,0,10"/>

                        <Button x:Name="btnSimpan" Content="+ Simpan Mahasiswa"
                                Background="#7F518F" Style="{StaticResource ActionButton}"
                                Click="BtnSimpan_Click" Margin="0,0,0,9"/>
                        <Button Content="Bersihkan Form" Background="#B592D2"
                                Style="{StaticResource ActionButton}" Click="BtnBatal_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="21">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Daftar Mahasiswa" FontSize="19"
                                       FontWeight="Bold" Foreground="#7F518F"/>
                            <TextBlock Text="Pilih baris untuk mengedit atau menghapus."
                                       FontSize="11" Foreground="#9B86A3" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="btnEdit" Grid.Column="1" Content="Edit"
                                Width="75" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="#FBB927" Foreground="#50375A"
                                IsEnabled="False" Style="{StaticResource ActionButton}"
                                Click="BtnEdit_Click"/>
                        <Button x:Name="btnHapus" Grid.Column="2" Content="Hapus"
                                Width="75" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="#FD8B4C" IsEnabled="False"
                                Style="{StaticResource ActionButton}" Click="BtnHapus_Click"/>
                    </Grid>

                    <TextBox x:Name="txtCari" Grid.Row="1" Height="40"
                             Padding="12,9" FontSize="13" Margin="0,0,0,15"
                             Background="#FFFBF5" BorderBrush="#D9BFE5"
                             BorderThickness="1" Foreground="#50375A"
                             ToolTip="Cari berdasarkan NRP, nama, atau prodi"
                             TextChanged="TxtCari_TextChanged"/>

                    <DataGrid x:Name="gridMahasiswa" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FAF2FF" RowBackground="White"
                              BorderThickness="0" Background="White"
                              RowHeight="38" ColumnHeaderHeight="40"
                              SelectionChanged="GridMahasiswa_SelectionChanged"
                              MouseDoubleClick="GridMahasiswa_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NRP" Binding="{Binding NRP}" Width="1.35*"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="1.8*"/>
                            <DataGridTextColumn Header="Program Studi" Binding="{Binding Prodi}" Width="1.65*"/>
                            <DataGridTextColumn Header="IPK" Binding="{Binding IPK, StringFormat={}{0:F2}}" Width="0.7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS -->
        <Border Grid.Row="3" Background="#B592D2" CornerRadius="9" Padding="13,9">
            <TextBlock x:Name="txtStatus" Text="Manajemen data mahasiswa."
                       FontSize="12" FontWeight="SemiBold" Foreground="#43274F"/>
        </Border>
    </Grid>
</Window>
