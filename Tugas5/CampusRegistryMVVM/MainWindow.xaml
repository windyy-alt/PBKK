<Window x:Class="CampusRegistryMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campus Registry | Student Dashboard"
        Width="1280" Height="800" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F1E2C3" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#003049"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#003049"/>
            <Setter Property="Background" Value="#FFF9F0"/>
            <Setter Property="BorderBrush" Value="#B7CFDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C1121F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#780000"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header aplikasi -->
        <Border Grid.Row="0" Background="#780000" CornerRadius="17"
                Padding="23,17" Margin="0,0,0,17">
            <StackPanel>
                <TextBlock Text="CAMPUS REGISTRY" FontSize="25"
                           FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Student Management Dashboard"
                           FontSize="13" Foreground="#F1E2C3" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Empat statistik dari seluruh data (bukan hanya hasil cari) -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,17">
            <Border Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="JUMLAH MAHASISWA" FontSize="11" Foreground="#003049" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding JumlahMahasiswa}" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="RATA-RATA IPK" FontSize="11" Foreground="#003049" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RataRataIpk}" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="IPK TERTINGGI" FontSize="11" Foreground="#003049" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding IpkTertinggi}" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="14" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="IPK TERENDAH" FontSize="11" Foreground="#003049" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding IpkTerendah}" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="365"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form input di kiri -->
            <Border Grid.Column="0" Background="White" CornerRadius="15"
                    Padding="22" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding FormTitle}" FontSize="19"
                                   FontWeight="Bold" Foreground="#780000"/>
                        <TextBlock Text="Isi data mahasiswa di bawah ini."
                                   FontSize="12" Foreground="#477286" Margin="0,4,0,22"/>

                        <TextBlock Text="NRP (10 digit)" Style="{StaticResource FormLabel}"/>
                        <TextBox MaxLength="10" Style="{StaticResource FormInput}"
                                 Text="{Binding Nrp, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Nama Lengkap" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource FormInput}"
                                 Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Program Studi" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource FormInput}"
                                 Text="{Binding Prodi, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="IPK (0 - 4)" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource FormInput}"
                                 Text="{Binding Ipk, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Jenis Kelamin" Style="{StaticResource FormLabel}"/>
                        <ComboBox SelectedValuePath="Content"
                                  SelectedValue="{Binding JenisKelamin, Mode=TwoWay}"
                                  Height="39" FontSize="14" Background="#FFF9F0"
                                  BorderBrush="#B7CFDD" Padding="8,4" Margin="0,0,0,14">
                            <ComboBoxItem Content="Laki-laki"/>
                            <ComboBoxItem Content="Perempuan"/>
                        </ComboBox>

                        <TextBlock Text="Tanggal Lahir" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding TanggalLahir, Mode=TwoWay}"
                                    Height="39" Background="#FFF9F0"
                                    BorderBrush="#B7CFDD" Margin="0,0,0,14"/>

                        <TextBlock Text="Alamat" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource FormInput}" Height="58"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Text="{Binding Alamat, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Nomor Telepon" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource FormInput}"
                                 Text="{Binding NoTelepon, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{Binding PesanForm}" Foreground="#C1121F"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>

                        <Button Content="{Binding SaveButtonText}" Command="{Binding SimpanCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,0,9"/>
                        <Button Content="Bersihkan Form" Command="{Binding BersihkanFormCommand}"
                                Background="#669BBC" Foreground="#003049" Style="{StaticResource ActionButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Tabel kanan -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="21">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Daftar Mahasiswa" FontSize="19"
                                       FontWeight="Bold" Foreground="#780000"/>
                            <TextBlock Text="Pilih baris untuk mengedit atau menghapus."
                                       FontSize="11" Foreground="#477286" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Edit" Command="{Binding EditCommand}"
                                Width="75" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="#669BBC" Foreground="#003049"
                                Style="{StaticResource ActionButton}"/>
                        <Button Grid.Column="2" Content="Hapus" Command="{Binding MintaHapusCommand}"
                                Width="75" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="#780000" Style="{StaticResource ActionButton}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#F1E2C3" BorderBrush="#FD8B4C"
                            BorderThickness="1" CornerRadius="10" Padding="12"
                            Margin="0,0,0,13"
                            Visibility="{Binding IsDeleteConfirmationOpen, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Yakin ingin menghapus data yang dipilih?"
                                       Foreground="#003049" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Ya, hapus" Command="{Binding KonfirmasiHapusCommand}"
                                    Background="#C1121F" Width="90" Margin="0,0,8,0"
                                    Style="{StaticResource ActionButton}"/>
                            <Button Content="Batal" Command="{Binding BatalHapusCommand}"
                                    Background="#669BBC" Foreground="#003049" Width="65"
                                    Style="{StaticResource ActionButton}"/>
                        </StackPanel>
                    </Border>

                    <TextBox Grid.Row="2" Height="40" Padding="12,9" FontSize="13"
                             Margin="0,0,0,15" Background="#FFF9F0"
                             BorderBrush="#B7CFDD" BorderThickness="1" Foreground="#003049"
                             ToolTip="Cari berdasarkan NRP, nama, atau prodi"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding MahasiswaTampil}"
                              SelectedItem="{Binding MahasiswaTerpilih, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                              SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F3F8FA"
                              RowBackground="White" BorderThickness="0" Background="White"
                              RowHeight="38" ColumnHeaderHeight="40"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E4EFF4"/>
                                <Setter Property="Foreground" Value="#003049"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="9,0"/>
                                <Setter Property="BorderBrush" Value="#B7CFDD"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="#003049"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="5,0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFE5D5"/>
                                        <Setter Property="Foreground" Value="#003049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NRP" Binding="{Binding Nrp}" Width="115"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="170"/>
                            <DataGridTextColumn Header="Program Studi" Binding="{Binding Prodi}" Width="150"/>
                            <DataGridTextColumn Header="IPK" Binding="{Binding Ipk, StringFormat={}{0:F2}}" Width="65"/>
                            <DataGridTextColumn Header="Jenis Kelamin" Binding="{Binding JenisKelamin}" Width="115"/>
                            <DataGridTextColumn Header="Tanggal Lahir" Binding="{Binding TanggalLahir, StringFormat={}{0:dd MMM yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="170"/>
                            <DataGridTextColumn Header="Telepon" Binding="{Binding NoTelepon}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
